{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "next build",
  "installCommand": "npm install",
  "devCommand": "next dev",
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/line/push-tomorrow",
      "schedule": "0 11 * * *"
    },
    {
      "path": "/api/admin/backup/cron",
      "schedule": "0 20 * * *"
    }
  ]
}
